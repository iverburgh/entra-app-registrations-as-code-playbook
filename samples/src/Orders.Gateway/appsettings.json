{
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<application-id-of-orders-gateway>"
  },
  "OnBehalfOf": {
    "KeyVaultUri": "https://kv-orders-dev.vault.azure.net/",
    "CertificateName": "AppReg-orders-gateway-dev"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders-api",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "invoices": {
        "ClusterId": "invoices-api",
        "Match": { "Path": "/api/invoices/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "orders-api": {
        "Metadata": { "Scope": "api://<application-id-of-orders-api>/access_as_user" },
        "Destinations": {
          "primary": { "Address": "https://orders-api-dev.example.com/" }
        }
      },
      "invoices-api": {
        "Metadata": { "Scope": "api://<application-id-of-invoices-api>/access_as_user" },
        "Destinations": {
          "primary": { "Address": "https://invoices.example.com/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
