{
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<application-id-of-orders-api>"
  },
  "InvoicesApi": {
    "BaseAddress": "https://invoices.example.com/",
    "Scope": "api://<application-id-of-invoices-api>/access_as_user"
  },
  "OnBehalfOf": {
    "KeyVaultUri": "https://kv-orders-dev.vault.azure.net/",
    "CertificateName": "AppReg-orders-api-dev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
