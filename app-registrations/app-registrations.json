{
  "$schema": "./schemas/app-registrations.schema.json",
  "appRegistrations": [
    {
      "key": "orders-api",
      "displayName": "orders-api#{instance}#-#{environment}#",
      "credential": {
        "type": "certificate",
        "keyVault": "kv-orders#{instance}#-#{environment}#",
        "tags": {
          "owner": "orders-team",
          "purpose": "Client credential of the orders API, for calls on behalf of users"
        }
      },
      "appRoles": [
        {
          "value": "Orders.Read",
          "displayName": "Order reader",
          "description": "Read orders and their history.",
          "allowedMemberTypes": ["User"]
        },
        {
          "value": "Orders.Admin",
          "displayName": "Order administrator",
          "description": "Change, cancel and refund orders.",
          "allowedMemberTypes": ["User"]
        },
        {
          "value": "Orders.Process",
          "displayName": "Order processor",
          "description": "Services that process orders in the background.",
          "allowedMemberTypes": ["Application"]
        }
      ],
      "scopes": [
        {
          "value": "access_as_user",
          "adminConsentDisplayName": "Access the orders API as the signed-in user",
          "adminConsentDescription": "Lets the application call the orders API on behalf of the signed-in user."
        }
      ],
      "preAuthorizedApplications": [
        { "application": "orders-web", "scopes": ["access_as_user"] },
        { "application": "azure-cli", "scopes": ["access_as_user"] }
      ],
      "requiredResourceAccess": [
        { "resource": "microsoft-graph", "scopes": ["User.Read"] }
      ]
    },
    {
      "key": "orders-web",
      "displayName": "orders-web#{instance}#-#{environment}#",
      "appRoles": [
        {
          "value": "Orders.Read",
          "displayName": "Order reader",
          "description": "See the orders screens.",
          "allowedMemberTypes": ["User"]
        },
        {
          "value": "Orders.Admin",
          "displayName": "Order administrator",
          "description": "See and use the order administration screens.",
          "allowedMemberTypes": ["User"]
        }
      ],
      "redirectUris": {
        "spa": "orders-web"
      },
      "requiredResourceAccess": [
        { "resource": "microsoft-graph", "scopes": ["User.Read"] },
        { "resource": "orders-api", "scopes": ["access_as_user"] }
      ]
    },
    {
      "key": "orders-worker",
      "displayName": "orders-worker#{instance}#-#{environment}#",
      "credential": {
        "type": "certificate",
        "keyVault": "kv-orders#{instance}#-#{environment}#",
        "tags": {
          "owner": "orders-team",
          "purpose": "Client credential of the orders worker"
        }
      },
      "appRoles": [],
      "requiredResourceAccess": [
        { "resource": "orders-api", "roles": ["Orders.Process"] },
        { "resource": "invoices-api-#{environment}#", "roles": ["Invoices.Create"] }
      ]
    },
    {
      "key": "orders-integration-tests",
      "displayName": "orders-integration-tests#{instance}#-#{environment}#",
      "credential": {
        "type": "secret",
        "name": "pipeline",
        "keyVault": "kv-orders#{instance}#-#{environment}#",
        "validityInMonths": 6
      },
      "requiredResourceAccess": [
        { "resource": "orders-api", "roles": ["Orders.Process"] }
      ]
    }
  ]
}
